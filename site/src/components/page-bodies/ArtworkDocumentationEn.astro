    display: grid;
    gap: 1rem;
  }

  .page-artwork-doc__distance-list {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .page-artwork-doc__distance-list li {
    border-top: 1px solid rgba(74, 13, 47, 0.12);
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0;
  }

  .page-artwork-doc__link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    padding: 0;
