    display: grid;
    gap: 1.5rem;
  }

  .page-artwork-doc__lead {
    align-items: start;
    margin: 1rem 0 2.5rem;
  }

  .page-artwork-doc__eyebrow {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .page-artwork-doc h1,
  .page-artwork-doc h2,
  .page-artwork-doc h3 {
    color: var(--color-text-strong);
  }

  .page-artwork-doc h1 {
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1.05;
    margin: 0 0 1rem;
  }

  .page-artwork-doc h2 {
    font-size: clamp(1.6rem, 2vw, 2.2rem);
    margin: 0 0 0.9rem;
  }

  .page-artwork-doc h3 {
    font-size: 1.15rem;
    margin: 1.25rem 0 0.5rem;
  }

  .page-artwork-doc p,
  .page-artwork-doc li,
  .page-artwork-doc dd {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .page-artwork-doc p,
  .page-artwork-doc ul,
  .page-artwork-doc ol {
    margin: 0 0 1rem;
  }

  .page-artwork-doc__lede {
    font-size: 1.15rem;
  }

  .page-artwork-doc__lead-figure,
  .page-artwork-doc__single-figure,
  .page-artwork-doc__image-grid figure {
    margin: 0;
  }

  .page-artwork-doc img {
    border-radius: 1rem;
    display: block;
    height: auto;
    width: 100%;
  }

  .page-artwork-doc__facts-card {
    background: rgba(255, 255, 255, 0.75);
