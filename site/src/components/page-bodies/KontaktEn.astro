---
import ContentSection from "../content/ContentSection.astro";
import StyledLink from "../ui/StyledLink.astro";

const kontaktMarkdown =
  "<p>For questions regarding tickets, event bookings or general information, please contact: <a href=\"mailto:info@andetag.museum\">info@andetag.museum</a></p>";

const pressMarkdown = [
  "<h2>Press</h2>",
  "<p><strong>Press Contact</strong><br />Gustaf Tadaa<br />0709-854979<br /><a href=\"mailto:info@andetag.museum\">info@andetag.museum</a></p>",
  '<p><a href="https://andetag.museum/presskit" target="_blank" rel="noreferrer noopener">Link to press kit</a></p>',
].join("");

const contentsamarbetenMarkdown = [
  "<h2>Content collaborations</h2>",
  "<p>Are you a content creator, photographer, or influencer looking for a unique and luminous backdrop for your work? We&#8217;d love to collaborate!</p>",
  "<p>Our space is a haven of glowing art, stillness, and inspiration, perfect for capturing truly one-of-a-kind content.</p>",
  '<p>Send an email to <a href="mailto:info@andetag.museum">info@andetag.museum</a> for inquiries.</p>',
  "<p>Let&#8217;s create something magical together.</p>",
].join("");
---

<div class="page-migrated page-kontakt-sv">
  <ContentSection heading="Contact" headingLevel="h1" markdown={kontaktMarkdown} />

  <div class="page-kontakt-sv__press-grid">
    <ContentSection markdown={pressMarkdown} />
    <ContentSection markdown={contentsamarbetenMarkdown} />
  </div>

  <div class="page-kontakt-sv__loc-mobile" aria-label="Address">
    <p class="page-kontakt-sv__loc-mobile-text">
      <span class="brand-wordmark">ANDETAG</span><br />
      Kungsgatan 39, Hötorget subway,<br /> Stockholm
    </p>
    <div class="page-kontakt-sv__hitta-row">
      <StyledLink label="Getting here" href="/en/stockholm/how-to-find-us/" styleVariant="cta-primary" />
    </div>
  </div>

  <div class="page-kontakt-sv__loc-desktop" aria-label="Address">
    <p class="page-kontakt-sv__loc-desktop-text">
      <span class="brand-wordmark">ANDETAG-</span>Kungsgatan 39, Hötorget subway, Stockholm
    </p>
    <div class="page-kontakt-sv__hitta-row">
      <StyledLink label="Getting here" href="/en/stockholm/how-to-find-us/" styleVariant="cta-primary" />
    </div>
  </div>
</div>
