---
import SiteLayout from "../../layouts/SiteLayout.astro";
import CollectorGuideEn from "../../components/page-bodies/CollectorGuideEn.astro";

const canonicalPath = "/en/collector/";
---

<SiteLayout
  title="Collector's Guide | ANDETAG"
  description="Practical collector guide for installing, connecting, caring for, and transporting ANDETAG artworks."
  language="en"
  destination="stockholm"
  headerVariantId="chrome-hdr-en-stockholm-small"
  footerVariantId="chrome-ftr-en-stockholm"
  canonicalPath={canonicalPath}
  hreflang={{ sv: null, en: canonicalPath, de: null }}
  robots="noindex,follow"
  includeStructuredData={false}
>
  <CollectorGuideEn />
</SiteLayout>
